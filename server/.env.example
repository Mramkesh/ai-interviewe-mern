# ---- Server (Render me ye sab Environment Variables me dalna) ----
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (password me special characters ho to URL-encode karna)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/interviewai?retryWrites=true&w=majority

# Koi bhi lamba random string (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_string_32_chars_min

# Groq API key (https://console.groq.com/keys) - ISKO KABHI GITHUB/FRONTEND ME MAT DALNA
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend ka URL (Vercel). Multiple ho to comma se alag karo. Local ke liye: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Admin panel login (pehli baar server start hone par ye admin ban jata hai)
ADMIN_EMAIL=admin@interviewai.com
ADMIN_PASSWORD=ChangeMe@12345
